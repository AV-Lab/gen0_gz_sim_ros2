  <library_effects>
    <effect id="Material_001-effect">
      <profile_COMMON>
        <newparam sid="gen0-surface">
          <surface type="2D">
            <init_from>gen0</init_from>
          </surface>
        </newparam>
        <newparam sid="gen0-sampler">
          <sampler2D>
            <source>gen0-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="gen0-sampler" texcoord="Roof_low-mesh-map-0"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
